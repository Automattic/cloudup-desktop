{
  "name": "cloudup-desktop",
  "productName": "Cloudup",
  "version": "1.0.1",
  "description": "Cloudup desktop app - webview wrapper with native OS integration",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "CLOUDUP_ENV=development npm run build && CLOUDUP_ENV=development electron .",
    "prod": "npm run build && electron .",
    "stage": "CLOUDUP_ENV=staging npm run build && CLOUDUP_ENV=staging electron .",
    "build": "tsc && node -e \"require('fs').writeFileSync('dist/shared/build-env.json', JSON.stringify({env: process.env.CLOUDUP_ENV || 'production'}))\"",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:stage": "CLOUDUP_ENV=staging npm run build && electron-builder --mac",
    "dist:win": "electron-builder --win",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "mutation:follow-up": "node scripts/mutation-follow-up.js",
    "mutation:weak-tests": "node scripts/mutation-weak-tests.js",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix"
  },
  "author": "Automattic",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "electron": "42.6.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.0",
    "handlebars": "^4.7.9",
    "app-builder-lib": {
      "@noble/hashes": "1.8.0"
    }
  }
}
